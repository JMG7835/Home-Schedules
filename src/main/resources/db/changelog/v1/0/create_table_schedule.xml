<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet id="202505021400" author="JMG">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="USERS"/>
            <not>
                <tableExists tableName="SCHEDULE"/>
            </not>
        </preConditions>

        <createTable tableName="SCHEDULE">
            <column name="id" type="bigint">
                <constraints primaryKey="true" primaryKeyName="schedule_id_pk" />
            </column>
            <column name="title" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(250)" />
            <column name="location" type="varchar(250)" />
            <column name="startDate" type="varchar(250)" >
                <constraints nullable="false"/>
            </column>
            <column name="endDate" type="varchar(250)" />
            <column name="status" type="varchar(250)" />
            <column name="principalUser" type="bigint" >
                <constraints nullable="false" foreignKeyName="fk_schedule_user" references="USERS(id)"/>
            </column>
        </createTable>

        <addAutoIncrement tableName="SCHEDULE" columnName="id" columnDataType="bigint" startWith="1" incrementBy="1" />
        <createSequence sequenceName="hibernate_sequence" incrementBy="1" startValue="1" />

        <rollback>
            <dropTable tableName="SCHEDULE"/>
        </rollback>

    </changeSet>

</databaseChangeLog>
